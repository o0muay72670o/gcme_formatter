{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Inspect sample (no AI cost)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["inspect", "input/ECM-05-008 AT 4 Ceiling Closure Check Sheet.xlsx"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Convert folder with AI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["batch", "input"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}

